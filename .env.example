# Copia este archivo como .env.local para desarrollo.

# PostgreSQL (desarrollo y producción). Local: PostgreSQL 18 de Homebrew (ver README).
# En producción: URL del pooler (PgBouncer / Neon / Supabase) con ?sslmode=require.
DATABASE_URL=postgresql://campus:campus_dev@localhost:5432/campus_lunita
# Conexiones máximas del pool por instancia del servidor.
# DATABASE_POOL_MAX=10

# Accesos rápidos de demostración por rol en /login.
# Solo funcionan fuera de producción y en un host local (localhost / 127.0.0.1).
# El servidor se niega a arrancar en producción si esta variable está en true.
DEMO_LOGIN_ENABLED=true

# Contraseña común de los usuarios semilla (npm run db:seed).
SEED_DEMO_PASSWORD=Lunita2026!

# URL pública del Campus, usada en los enlaces que se envían por correo.
# OBLIGATORIA en producción (nunca se toma de la cabecera Host).
# APP_URL=https://campus.liceolunita.edu.co

# Correo transaccional (recuperación de contraseña). Sin SMTP_URL, en desarrollo
# los correos se muestran en la consola del servidor.
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.com:465
# MAIL_FROM=Campus Lunita <no-responder@liceolunita.edu.co>
